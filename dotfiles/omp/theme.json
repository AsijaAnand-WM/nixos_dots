{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#7E46B6",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "#ffffff",
          "style": "plain",
          "template": "in ",
          "type": "text"
        },
        {
          "foreground": "#87FF00",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
            "foreground": "#5FD7FF",
            "options": {
                "fetch_status": true,
                "ignore_working_copy": false,
                "fetch_ahead_counter": true,
                "ahead_icon": "⇡"
            },
            "style": "plain",
            "template": "<#ffffff>on</> {{.ClosestBookmarks}} {{if .Working.Changed}}<#D75F00>\u25cf {{.Working.String}}</>{{end}} ",
            "type": "jujutsu"
        },
        {
          "foreground": "#D75F00",
          "style": "plain",
          "template": "λ ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 4
}

