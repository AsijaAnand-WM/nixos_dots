(defsrc
                q     w     e     r     t         y     u     i     o     p
        caps    a     s     d     f     g         h     j     k     l     ;
                z     x     c     v     b         n     m     ,     .     /
                                                    ralt
  )

(deflayer base
                q     w     e     r     t         y     u     i     o     p
        @lay    a     s     d     f     g         h     j     k     l     ;
                z     x     c     v     b         n     m     ,     .     /
                                                    lsft
        )

(deflayer sym
                XX    grv   @-    @=    @apos     XX     4     5     6     XX
        _       @[    @]    @{    @}    bspc      ret    0     1     2     3
                XX    XX    @\    XX    XX        XX     7     8     9     @/
                                                    lsft
        )

(defalias
        apos   '
        [      [
        {      S-[
        }      S-]
        ]      ]
        \      \
        -      -
        =      =
        /      /

        lay (layer-while-held sym)
)

